<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>$(NetCurrent);$(NetMinimum)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);NU1301</NoWarn>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" VersionOverride="$(MicrosoftNetRuntimeVersion)" />
    <PackageReference Include="System.Formats.Asn1" VersionOverride="$(MicrosoftNetRuntimeVersion)" />
    <PackageReference Include="System.Reflection.Metadata" VersionOverride="$(MicrosoftNetRuntimeVersion)" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" VersionOverride="$(MicrosoftNetRuntimeVersion)" />
  </ItemGroup>

</Project>
